# 统一换行符 —— 关键：shell 脚本必须是 LF，
# 否则在 Linux / macOS 上会因行尾的 \r 报 "bad interpreter"。
* text=auto eol=lf

*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf

# Windows 专用文件
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制
*.jar     binary
*.apk     binary
*.keystore binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
