<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 取景框 -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_scan_frame" />

    <TextView
        android:id="@+id/tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="128dp"
        android:padding="12dp"
        android:text="对准二维码"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="关闭"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close" />

    <!-- 手电筒：底部居中 -->
    <ImageButton
        android:id="@+id/btnTorch"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_torch"
        android:contentDescription="手电筒"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_torch" />

    <!-- 相册导入：右下角，截图之后从这里选图识别 -->
    <ImageButton
        android:id="@+id/btnAlbum"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|right"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_torch"
        android:contentDescription="从相册导入"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_album" />

</FrameLayout>
