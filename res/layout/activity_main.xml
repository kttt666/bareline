<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 网页层 -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:visibility="gone" />

    <!-- 首页层：只有一个输入框 + 扫码 -->
    <LinearLayout
        android:id="@+id/homeLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:letterSpacing="0.28"
            android:text="BARELINE"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="18dp"
            android:paddingRight="6dp">

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="输入网址"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/scanBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_scan_btn"
                android:contentDescription="扫码"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_scan" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="扫电脑上的二维码，直连 DSH"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 点空白处收起面板 -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:visibility="gone" />

    <!-- 左下角浮出的小面板（默认隐藏，不占任何位置） -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="286dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|left"
        android:layout_marginLeft="74dp"
        android:background="@drawable/bg_panel"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <!-- 浏览态才显示：后退 / 地址 / 刷新 / 扫码 -->
        <LinearLayout
            android:id="@+id/barRow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="后退"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back" />

            <EditText
                android:id="@+id/barInput"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:hint="输入网址"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="刷新"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_reload" />

            <ImageButton
                android:id="@+id/btnScan2"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="扫码"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_scan" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/listTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="最近打开"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="清空"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 密码库入口 -->
        <LinearLayout
            android:id="@+id/btnVault"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="密码库"
                android:src="@drawable/ic_key"
                android:tint="@color/muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="密码库"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/vaultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:background="@color/line" />

        <ScrollView
            android:id="@+id/listScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="260dp"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/linkList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </ScrollView>
    </LinearLayout>

    <!-- 屏幕最左边缘的小三角：平时只有它，点一下才把 ☰ 放出来 -->
    <ImageButton
        android:id="@+id/edgeTab"
        android:layout_width="15dp"
        android:layout_height="46dp"
        android:layout_gravity="center_vertical|left"
        android:background="@drawable/bg_edge"
        android:contentDescription="展开菜单按钮"
        android:elevation="6dp"
        android:paddingLeft="1dp"
        android:paddingRight="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_edge"
        android:tint="@color/muted" />

    <!-- 左下角小半透明按钮：默认藏起来，点三角才出现 -->
    <ImageButton
        android:id="@+id/fab"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|left"
        android:layout_marginLeft="22dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="最近打开"
        android:elevation="6dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_list"
        android:visibility="gone" />

    <!-- 密码填充按钮：只在页面上有密码框时出现，叠在 ☰ 上面 -->
    <ImageButton
        android:id="@+id/fabKey"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|left"
        android:layout_marginLeft="22dp"
        android:background="@drawable/bg_key_fab"
        android:contentDescription="填入密码"
        android:elevation="7dp"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_key"
        android:translationY="-52dp"
        android:visibility="gone" />

    <!-- 密码库浮层 -->
    <FrameLayout
        android:id="@+id/vaultHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:visibility="gone" />

</FrameLayout>
